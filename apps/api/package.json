{
  "name": "@taco-hunt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "pnpm --filter @taco-hunt/contracts build && tsc --noEmit",
    "build": "pnpm --filter @taco-hunt/contracts build && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "media:cleanup": "tsx scripts/cleanup-orphan-photos.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "file-type": "21.3.4",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@supabase/supabase-js": "^2.117.2",
    "@taco-hunt/contracts": "workspace:*",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "fastify": "^5.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

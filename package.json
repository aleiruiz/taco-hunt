{
  "name": "taco-hunt",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Taco Hunt, a street taco discovery app.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm --filter @taco-hunt/api typecheck && npm --prefix apps/mobile run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm --filter @taco-hunt/api dev",
    "dev:mobile": "node apps/mobile/start.mjs",
    "dev:landing": "pnpm --filter @taco-hunt/landing dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "supabase": "supabase"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "supabase": "2.118.0",
    "typescript-eslint": "8.44.0"
  }
}

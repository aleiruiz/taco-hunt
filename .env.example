# Taco Hunt local development
# Copy this file to .env and fill in values from `pnpm db:status` once the local stack is running.
# Never put server-only secrets (DB owner/runtime password, service role key, signing keys) in EXPO_PUBLIC_* variables.

PORT=3001
# Trust no proxy by default; set to the exact number of trusted ingress hops in deployment.
TRUST_PROXY_HOPS=0
# Provision this server-only role locally with: .\supabase\dev-role.ps1 provision
DATABASE_URL=postgresql://taco_hunt_api:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:55422/postgres
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_JWT_ISSUER=http://127.0.0.1:55421/auth/v1
# Server-only legacy HS256 signing secret for local Supabase Auth. Never use this in Expo.
SUPABASE_JWT_SECRET=replace-with-server-only-local-jwt-secret
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Expo mobile app: use only the public Supabase Auth URL/key and the API URL.
EXPO_PUBLIC_API_URL=http://localhost:3001/v1
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Optional for Android Maps SDK only; keep the key restricted to the app/signing certificate and SDK.
EXPO_PUBLIC_ANDROID_MAPS_API_KEY=
